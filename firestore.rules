rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/backups/{backupId} {
      function owner() { return request.auth != null && request.auth.uid == uid; }
      allow read: if owner();
      allow create: if owner()
        && request.resource.data.keys().hasOnly(['payload','hash','createdAt','eventCount'])
        && request.resource.data.payload is string
        && request.resource.data.payload.size() <= 900000
        && request.resource.data.hash is string
        && request.resource.data.hash.matches('[a-f0-9]{64}')
        && request.resource.data.createdAt == request.time
        && request.resource.data.eventCount is int
        && request.resource.data.eventCount >= 0;
      allow update, delete: if false;
    }
  }
}
